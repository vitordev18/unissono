# Copie para .env e preencha. NUNCA versione o .env.
#
# Chaves EXPO_PUBLIC_* são embutidas no bundle do app e, portanto, públicas.
# A proteção dos dados vem da RLS no Postgres, não do sigilo destas chaves.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Os segredos abaixo NÃO vão para o app. Ficam apenas nos secrets das
# Edge Functions do Supabase (supabase secrets set ...), a partir da Fase 6:
#   SUPABASE_SERVICE_ROLE_KEY=
#   YOUTUBE_API_KEY=
